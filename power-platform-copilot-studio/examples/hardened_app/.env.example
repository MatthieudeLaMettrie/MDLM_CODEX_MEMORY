# Copy to .env for LOCAL runs only (never commit .env). In Azure set these as container app settings.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_AGENT_NAME=<agent-name>

# default = managed identity in Azure / az login on a laptop. Others: client_secret, device_code, obo (experimental)
CRED_MODE=default
# TENANT_ID=<tenant guid>                 # needed for client_secret, device_code, obo
# CLIENT_ID=<application (client) id>     # client_secret, obo
# CLIENT_SECRET=<secret value>            # client_secret, obo: store as a container app SECRET, never in code
# MANAGED_IDENTITY_CLIENT_ID=<id>         # only for a user-assigned managed identity

# Local development only: skip Easy Auth and act as one fixed user. NEVER false when deployed.
REQUIRE_LOGIN=true
# DEV_USER=local-dev
# ALLOWED_USERS=alice@contoso.com,bob@contoso.com   # optional allow-list on top of Entra assignment

RATE_PER_MINUTE=6
DAILY_LIMIT=100
MAX_CHARS=1500
MAX_CONCURRENT=4
REQUEST_TIMEOUT=90
FRAME_ANCESTORS='none'
# For a SharePoint embed use: FRAME_ANCESTORS=https://*.sharepoint.com
SHOW_TOOLS=false
LOG_CONTENT=false
